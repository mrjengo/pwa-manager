import { Button, LineEdit, ComboBox, ListView, ProgressIndicator, Spinner, Palette } from "std-widgets.slint";

export struct AppItem {
    name: string,
    url: string,
    icon: image,
    has-icon: bool,
}

component AppRow inherits Rectangle {
    in property <AppItem> item;
    in property <bool> selected;
    callback clicked();

    height: 56px;
    border-radius: 8px;
    background: root.selected ? Palette.selection-background : touch.has-hover ? Palette.control-background : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Image {
            width: 36px;
            height: 36px;
            source: root.item.has-icon ? root.item.icon : @image-url("../assets/pwa-manager.svg");
            image-fit: contain;
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.item.name;
                font-weight: 600;
                overflow: elide;
                color: root.selected ? Palette.selection-foreground : Palette.foreground;
            }
            Text {
                text: root.item.url;
                font-size: 11px;
                overflow: elide;
                opacity: 0.7;
                color: root.selected ? Palette.selection-foreground : Palette.foreground;
            }
        }
    }
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;
    Text {
        text: root.label;
        width: 80px;
        vertical-alignment: center;
        horizontal-alignment: right;
        opacity: 0.8;
    }
    @children
}

export component AppWindow inherits Window {
    title: "PWA Manager";
    icon: @image-url("../assets/pwa-manager.svg");
    preferred-width: 940px;
    preferred-height: 600px;
    min-width: 780px;
    min-height: 500px;

    in property <[AppItem]> apps;
    in property <int> selected-index: -1;
    in property <[string]> browser-labels;
    in-out property <int> browser-index;
    in property <[string]> profile-labels;
    in-out property <int> profile-index;
    in-out property <string> custom-profile;
    in-out property <string> form-name;
    in-out property <string> form-url;
    in-out property <string> form-icon;
    in property <image> form-icon-preview;
    in property <bool> form-has-icon;
    in property <bool> busy;
    in property <string> status;
    in property <bool> status-is-error;
    in property <bool> engine-installed;
    in property <bool> engine-busy;
    in property <float> engine-progress;
    in property <string> engine-name;

    callback app-selected(int);
    callback new-app();
    callback save();
    callback remove();
    callback launch();
    callback browse-icon();
    callback browser-changed(int);
    callback download-engine();

    property <bool> editing: root.selected-index >= 0;
    property <bool> no-browsers: root.browser-labels.length == 0;
    property <bool> custom-profile-selected: root.profile-index == root.profile-labels.length - 1;

    HorizontalLayout {
        // Sidebar: installed apps.
        Rectangle {
            width: 300px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Installed apps";
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "+ New";
                        clicked => { root.new-app(); }
                    }
                }
                if root.apps.length == 0: Text {
                    text: "No apps yet. Fill in the form to install your first one.";
                    wrap: word-wrap;
                    opacity: 0.7;
                }
                ListView {
                    vertical-stretch: 1;
                    for item[i] in root.apps: AppRow {
                        item: item;
                        selected: i == root.selected-index;
                        clicked => { root.app-selected(i); }
                    }
                }
            }
        }

        // Editor.
        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            horizontal-stretch: 1;

            if root.no-browsers || root.engine-busy: Rectangle {
                border-radius: 8px;
                background: Palette.control-background;
                border-width: 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Text {
                        text: root.engine-busy
                            ? "Downloading " + root.engine-name + "…"
                            : "No Chromium-based browser was found. PWA Manager can download " + root.engine-name + ", a free and open-source Chromium without Google services, just for your apps.";
                        wrap: word-wrap;
                    }
                    if root.engine-busy: ProgressIndicator {
                        progress: root.engine-progress;
                        indeterminate: root.engine-progress < 0;
                    }
                    if !root.engine-busy: HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "Download " + root.engine-name;
                            primary: true;
                            clicked => { root.download-engine(); }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                Image {
                    width: 56px;
                    height: 56px;
                    source: root.form-has-icon ? root.form-icon-preview : @image-url("../assets/pwa-manager.svg");
                    image-fit: contain;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.editing ? root.form-name : "New app";
                        font-size: 22px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: root.editing ? "Edit and save to update the launcher." : "Turn any website into a desktop app.";
                        opacity: 0.7;
                    }
                }
            }

            Field {
                label: "Name";
                LineEdit {
                    text <=> root.form-name;
                    placeholder-text: "My App";
                }
            }
            Field {
                label: "URL";
                LineEdit {
                    text <=> root.form-url;
                    placeholder-text: "https://app.example.com";
                }
            }
            Field {
                label: "Icon";
                LineEdit {
                    text <=> root.form-icon;
                    placeholder-text: root.editing ? "Keep the current icon" : "Empty: taken from the website automatically";
                }
                Button {
                    text: "Browse…";
                    clicked => { root.browse-icon(); }
                }
            }
            Field {
                label: "Browser";
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.browser-labels;
                    current-index <=> root.browser-index;
                    enabled: !root.no-browsers;
                    selected => { root.browser-changed(self.current-index); }
                }
                if !root.engine-installed && !root.no-browsers && !root.engine-busy: Button {
                    text: "Get " + root.engine-name;
                    clicked => { root.download-engine(); }
                }
            }
            Field {
                label: "Profile";
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.profile-labels;
                    current-index <=> root.profile-index;
                }
            }
            if root.custom-profile-selected: Field {
                label: "";
                LineEdit {
                    text <=> root.custom-profile;
                    placeholder-text: "Profile directory, e.g. Profile 3";
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 10px;
                if root.busy: Spinner {
                    indeterminate: true;
                    width: 22px;
                    height: 22px;
                }
                Text {
                    text: root.status;
                    color: root.status-is-error ? #d13438 : Palette.foreground;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.editing: Button {
                    text: "Remove";
                    enabled: !root.busy;
                    clicked => { confirm.show(); }
                }
                if root.editing: Button {
                    text: "Launch";
                    enabled: !root.busy;
                    clicked => { root.launch(); }
                }
                Button {
                    text: root.editing ? "Save" : "Install";
                    primary: true;
                    enabled: !root.busy && !root.no-browsers;
                    clicked => { root.save(); }
                }
            }
        }
    }

    confirm := PopupWindow {
        x: (root.width - 360px) / 2;
        y: (root.height - 150px) / 2;
        width: 360px;
        height: 150px;
        Rectangle {
            background: Palette.background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 18px;
                spacing: 14px;
                Text {
                    text: "Remove “" + root.form-name + "”?";
                    font-size: 16px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: "The launcher and its icon are deleted. Browser data is kept.";
                    wrap: word-wrap;
                    opacity: 0.8;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    Button { text: "Cancel"; }
                    Button {
                        text: "Remove";
                        primary: true;
                        clicked => { root.remove(); }
                    }
                }
            }
        }
    }
}
